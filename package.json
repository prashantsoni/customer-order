{
  "name": "customer-order",
  "version": "0.1.0",
  "private": true,
  "description": "Local JavaScript app for managing customers, orders and order lines (localStorage).",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve src -l 5173 --no-port-switching",
    "check": "node scripts/check.js",
    "test": "node --test",
    "test:e2e": "playwright test --project=desktop-chromium --project=desktop-webkit --project=phone-360 && playwright test --project=desktop-firefox --workers=1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
